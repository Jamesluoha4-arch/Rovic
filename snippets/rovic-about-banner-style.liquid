{% comment %}Keep the existing hero bounds; place the supplied artwork above the page copy.{% endcomment %}
#shopify-section-{{ section.id }} .banner { background: #111b10; }
#shopify-section-{{ section.id }} .banner__media { height: clamp(140px, 19.14vw, 392px); max-height: 52%; }
#shopify-section-{{ section.id }} .rovic-banner-photo { object-fit: cover; object-position: 52% center; transform: none; }
#shopify-section-{{ section.id }} .banner__overlay { display: none; }
#shopify-section-{{ section.id }} .banner__content > .page-width { align-items: flex-end; padding-block: 20px; }
#shopify-section-{{ section.id }} .banner__box > * + * { margin-top: 12px; }
#shopify-section-{{ section.id }} .banner__title { font-size: clamp(26px, 3vw, 48px); }
#shopify-section-{{ section.id }} .banner__box .rte { font-size: clamp(14px, 1.15vw, 18px); }
