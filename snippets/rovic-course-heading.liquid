{% comment %}Only the text header changes; the collage markup and image blocks remain intact.{% endcomment %}
<style>
  #shopify-section-{{ section.id }} .course-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: end; margin-bottom: 28px; }
  #shopify-section-{{ section.id }} .course-heading__eyebrow { margin: 0 0 12px; font-size: 12px; font-weight: 600; letter-spacing: .14em; line-height: 1.4; }
  #shopify-section-{{ section.id }} .course-heading__title { margin: 0; max-width: 28ch; font-size: clamp(24px, 2.2vw, 34px); line-height: 1.15; letter-spacing: -.035em; }
  #shopify-section-{{ section.id }} .course-heading__description { max-width: 58ch; font-size: 15px; line-height: 1.65; }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .course-heading { grid-template-columns: minmax(0, 1fr); gap: 16px; margin-bottom: 24px; }
  }
</style>
<div class="course-heading">
  <div>
    {% if section.settings.subheading != blank %}<p class="course-heading__eyebrow">{{ section.settings.subheading | escape }}</p>{% endif %}
    <{{ section.settings.heading_tag }} class="course-heading__title heading">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
  </div>
  {% if section.settings.description != blank %}<div class="course-heading__description rte">{{ section.settings.description }}</div>{% endif %}
</div>
