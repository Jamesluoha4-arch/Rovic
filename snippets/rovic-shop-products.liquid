<div class="section section--padding"><div class="page-width"><h1 class="sr-only">Shop</h1>
{%- assign shop_groups = 'all-push-carts,accessories' | split: ',' -%}
{%- capture card_sizes -%}(max-width: 639px) calc(100vw / {{ section.settings.columns_mobile }}), calc(min({{ settings.page_width }}px, 100vw) / {{ section.settings.columns }}){%- endcapture -%}
{%- assign seen_ids = '|' -%}
{%- for handle in shop_groups -%}
  {%- assign shop_collection = collections[handle] -%}
  {%- paginate shop_collection.products by 250 -%}
  <motion-list class="card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid relative" style="margin-bottom:var(--grid-gap,24px)">
  {%- for product in shop_collection.products -%}
    {%- liquid
      assign is_part = false
      for membership in product.collections
        if membership.handle == 'parts'
          assign is_part = true
        endif
      endfor
      assign title = product.title | downcase
      if title == 'replacement wheel set' or title == 'replacement bag straps' or title == 'adjustable umbrella holder' or title == 'rv2l extended seat' or title == 'rv1 series extended seat'
        assign is_part = true
      endif
      assign token = product.id | prepend: '|' | append: '|'
      if is_part or seen_ids contains token
        continue
      endif
      assign seen_ids = seen_ids | append: product.id | append: '|'
      assign lazy_load = true
      if forloop.index <= 2
        assign lazy_load = false
      endif
    -%}
    {%- render 'product-card',
                  product: product,
                  product_id: product.id,
                  section_id: section.id,
                  lazy_load: lazy_load,
                  sizes: card_sizes,
                  image_ratio: settings.product_image_ratio,
                  image_fill: settings.product_image_fill,
                  show_secondary_image: settings.product_secondary_image,
                  show_multiple_images: settings.product_multiple_images,
                  show_vendor: settings.product_vendor,
                  title_truncation: settings.product_title_truncation,
                  title_line_limit: settings.product_title_line_limit,
                  show_rating: settings.product_rating,
                  show_color_swatches: settings.product_color_swatches,
                  show_countdown: settings.product_countdown,
                  show_quick_add: settings.product_quick_add,
                  show_quick_view: settings.product_quick_view,
                  vertical_badges: settings.product_vertical_badges,
                  show_sold_out: settings.product_sold_out,
                  show_save_amount: settings.product_save_amount,
                  save_type: settings.product_save_type,
                  show_icon_list: settings.product_icon_list,
                  show_on_model: show_on_model
                -%}
  {%- endfor -%}
  </motion-list>
  {%- if paginate.pages > 1 -%}{%- render 'pagination', paginate: paginate, mode: 'default' -%}{%- endif -%}
  {%- endpaginate -%}
{%- endfor -%}
</div></div>
