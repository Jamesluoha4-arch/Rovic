{% comment %}Homepage editorial introduction, aligned to the image grid below.{% endcomment %}
<style>
  #shopify-section-{{ section.id }} .brand-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; padding-block: 64px 48px; border-bottom: 1px solid rgb(var(--color-foreground) / .16); }
  #shopify-section-{{ section.id }} .brand-intro__heading { margin: 0; max-width: 15ch; font-size: clamp(32px, 3.3vw, 52px); line-height: 1.08; letter-spacing: -.04em; }
  #shopify-section-{{ section.id }} .brand-intro__heading em { font-style: normal; }
  #shopify-section-{{ section.id }} .brand-intro__copy { font-size: 16px; line-height: 1.65; max-width: 62ch; }
  #shopify-section-{{ section.id }} .brand-intro__copy .rte + .rte { margin-top: 16px; }
  #shopify-section-{{ section.id }} .brand-intro__action { margin-top: 24px; }
  #shopify-section-{{ section.id }} .brand-intro__trajectory { display: block; width: min(100%, 440px); height: auto; margin-top: 22px; color: #c5e8b8; overflow: visible; pointer-events: none; }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .brand-intro__trajectory { width: min(85%, 340px); margin-top: 12px; }
    #shopify-section-{{ section.id }} .brand-intro { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 40px 32px; }
    #shopify-section-{{ section.id }} .brand-intro__copy { font-size: 15px; }
  }
</style>
<div class="page-width">
  <div class="brand-intro">
    <div class="brand-intro__title">
      <{{ section.settings.heading_tag }} class="brand-intro__heading heading">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
      <svg class="brand-intro__trajectory" viewBox="0 0 440 116" fill="none" aria-hidden="true" focusable="false">
        <path d="M12 94 C43 77 71 84 94 92 C116 100 130 101 151 84 C214 33 303 5 399 25" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
        <path d="M16 98 C47 83 70 88 91 95" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity=".5" />
        <circle cx="418" cy="29" r="9" fill="currentColor" />
        <circle cx="415" cy="26" r="1.3" fill="white" opacity=".8" />
        <circle cx="421" cy="27" r="1.1" fill="white" opacity=".65" />
        <circle cx="418" cy="32" r="1.2" fill="white" opacity=".65" />
      </svg>
    </div>
    <div class="brand-intro__copy">
      {% for block in section.blocks %}
        {% if block.type == 'text' %}<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{% endif %}
      {% endfor %}
      {% if section.settings.button_label != blank %}
        <div class="brand-intro__action">{% render 'button', style: 'secondary', label: section.settings.button_label, link: section.settings.button_link, external: section.settings.button_external, show_icon: section.settings.button_icon %}</div>
      {% endif %}
    </div>
  </div>
</div>
