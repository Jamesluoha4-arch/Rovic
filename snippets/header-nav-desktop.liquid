{%- doc -%}
  Renders desktop header navigation with mega menus, dropdowns, and advanced interactions.

  Supports multi-level navigation, Section Rendering API, and sophisticated hover/click behaviors.

  @param {object} section - Section object with navigation settings and mega menu blocks
  @param {object} main_menu - Shopify navigation menu object to render
  @param {string} context - Position identifier for unique IDs ('start' or 'end')
  @param {number} [limit] - Maximum menu links to display
  @param {number} [offset] - Number of links to skip from start

  @example
  {% render 'header-nav-desktop',
     section: section,
     main_menu: linklists.main-menu,
     context: 'start',
     limit: 5
  %}
{%- enddoc -%}

{%- liquid
  unless limit
    assign limit = main_menu.links.size
  endunless
  unless offset
    assign offset = 0
  endunless

  assign section_rendering_api = false
  assign push_carts_url = routes.collections_url | append: '/all-push-carts'
  assign disc_golf_carts_url = routes.collections_url | append: '/junior-push-carts'
  assign accessories_url = routes.collections_url | append: '/accessories'
  if section.index == nil
    assign section_rendering_api = true
  endif
-%}

<ul class="flex flex-wrap{% unless section.settings.hover_menu %} gap-1{% endunless %} list-menu with-{{ section.settings.menu_active }}" role="list">
  {%- for link in main_menu.links limit: limit offset: offset -%}
    {%- if link.title == 'QFC New Arrival' -%}{%- continue -%}{%- endif -%}
    {%- if link.url == routes.collections_url and link.title != 'Shop' -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign nav_active = link.current
      if link.child_active or link.active
        assign nav_active = true
      endif
      if link.title == 'Shop'
        assign nav_active = false
        if collection.handle == 'all'
          assign nav_active = true
        endif
      endif
      if link.title == 'Push Carts'
        assign nav_active = false
        if collection.handle == 'all-push-carts' or collection.handle == 'junior-push-carts'
          assign nav_active = true
        endif
      endif
      assign nav_label = link.title
      if link.title == 'Push Carts'
        assign nav_label = 'Carts'
      endif
      assign enable_mega_menu = false
      assign mega_menu_block = nil
      assign link_title_handle = link.title | downcase | handle

      for block in section.blocks
        assign menu_title_handle = block.settings.menu_title | downcase | handle
        if menu_title_handle == link_title_handle
          assign enable_mega_menu = true
          assign mega_menu_block = block
          break
        endif
      endfor
    -%}
    {%- if link.title == 'Shop' -%}
      <li{% if nav_active %} class="rovic-nav-active"{% endif %}>
        <a {% if nav_active %}aria-current="page"{% endif %} href="{{ routes.all_products_collection_url }}" class="menu__item text-sm-lg flex items-center font-medium z-2 relative cursor-pointer" is="magnet-link"{% if section.settings.menu_active == 'block' %} data-magnet="0"{% endif %} aria-label="Shop">
          <span class="btn-text" data-text>Shop</span>
          {%- if section.settings.menu_active == 'block' -%}<span class="btn-text btn-duplicate">Shop</span>{%- endif -%}
        </a>
      </li>
    {%- elsif enable_mega_menu -%}
      <li{% if nav_active %} class="rovic-nav-active"{% endif %}>
        <details is="details-mega" trigger="{% if section.settings.hover_menu %}hover{% else %}click{% endif %}" level="top" {{ mega_menu_block.shopify_attributes }}>
          <summary{% unless link.title == 'Push Carts' %} data-link="{{ link.url }}"{% endunless %} class="z-2 relative{% if section.settings.menu_active == 'block' %} rounded-full{% endif %}" aria-haspopup="true" aria-expanded="false" aria-label="{{ nav_label | escape }}">
            <magnet-element class="menu__item text-sm-lg flex items-center font-medium z-2 relative cursor-pointer"{% if section.settings.menu_active == 'block' %} data-magnet="0"{% endif %}>
              {%- unless section_rendering_api -%}
                <api-button class="api-only" data-id="HeaderNavMega-{{ section.id }}-{{ forloop.index }}-{{ context }}" data-section-id="{{ section.id }}"></api-button>
              {%- endunless -%}
              <span class="btn-text" data-text>
                {%- liquid
                  echo nav_label
                  unless section.settings.hover_menu
                    render 'icon', icon: 'chevron-menu'
                  endunless
                -%}
              </span>
              {%- if section.settings.menu_active == 'block' -%}
                <span class="btn-text btn-duplicate">
                  {%- liquid
                    echo nav_label
                    unless section.settings.hover_menu
                      render 'icon', icon: 'chevron-menu'
                    endunless
                  -%}
                </span>
              {%- endif -%}
            </magnet-element>
          </summary>
          <div class="mega-menu absolute top-0 left-0 w-full max-w-full overflow-hidden pointer-events-none">
            {%- render 'header-nav-mega', section: section, link: link, block: mega_menu_block, full_width: section.settings.full_width, position: forloop.index, context: context -%}
          </div>
        </details>
      </li>
    {%- elsif link.links != blank -%}
      <li{% if nav_active %} class="rovic-nav-active"{% endif %}>
        <details is="details-dropdown" trigger="{% if section.settings.hover_menu %}hover{% else %}click{% endif %}" level="top">
          <summary{% unless link.title == 'Push Carts' %} data-link="{{ link.url }}"{% endunless %} class="z-2 relative{% if section.settings.menu_active == 'block' %} rounded-full{% endif %}" aria-haspopup="true" aria-expanded="false" aria-label="{{ nav_label | escape }}">
            <magnet-element class="menu__item text-sm-lg flex items-center font-medium z-2 relative cursor-pointer"{% if section.settings.menu_active == 'block' %} data-magnet="0"{% endif %}>
              <span class="btn-text" data-text>
                {%- liquid
                  echo nav_label
                  unless section.settings.hover_menu
                    render 'icon', icon: 'chevron-menu'
                  endunless
                -%}
              </span>
              {%- if section.settings.menu_active == 'block' -%}
                <span class="btn-text btn-duplicate">
                  {%- liquid
                    echo nav_label
                    unless section.settings.hover_menu
                      render 'icon', icon: 'chevron-menu'
                    endunless
                  -%}
                </span>
              {%- endif -%}
            </magnet-element>
          </summary>
          <div id="DropdownMenu-{{ section.id }}-{{ forloop.index }}-{{ context }}" class="dropdown rovic-dropdown-panel opacity-0 invisible absolute pointer-events-none">
            <div class="dropdown__container relative">
              {%- render 'corner', dir: 'top', prefix: 'dropdown' -%}
              <ul class="dropdown__nav flex flex-col gap-1d5 xl:gap-2" role="list">
                {%- if link.title == 'Push Carts' -%}
                  <li class="opacity-0"><p><a href="{{ push_carts_url }}" class="reversed-link text-sm-base">Push Carts</a></p></li>
                  <li class="opacity-0"><p><a href="{{ disc_golf_carts_url }}" class="reversed-link text-sm-base">DISC Golf Carts</a></p></li>
                {%- else -%}
                  {%- for childlink in link.links -%}
                  {%- if childlink.url == routes.collections_url -%}{%- continue -%}{%- endif -%}
                  {%- if childlink.links != blank -%}
                    <li class="opacity-0 relative">
                      <details is="details-dropdown" trigger="{% if section.settings.hover_menu %}hover{% else %}click{% endif %}" level="child">
                        <summary data-link="{{ childlink.url }}">
                          <a href="{{ childlink.url }}" class="reversed-link text-sm-base" tabindex="-1">{{ childlink.title }}</a>
                        </summary>
                        <div class="dropdown opacity-0 invisible absolute top-0 left-100 max-w-full pointer-events-none">
                          <div class="dropdown__container">
                            <ul class="dropdown__nav flex flex-col gap-1d5 xl:gap-2" role="list">
                              {%- for grandchildlink in childlink.links -%}
                                <li class="opacity-0">
                                  <p>
                                    <a href="{{ grandchildlink.url }}" class="reversed-link text-sm-base">{{ grandchildlink.title }}</a>
                                  </p>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        </div>
                      </details>
                    </li>
                  {%- else -%}
                    <li class="opacity-0">
                      <p>
                        <a href="{{ childlink.url }}" class="reversed-link text-sm-base">{{ childlink.title }}</a>
                      </p>
                    </li>
                  {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          </div>
        </details>
      </li>
    {%- else -%}
      <li{% if nav_active %} class="rovic-nav-active"{% endif %}>
        <a {% if link.current %}aria-current="page"{% endif %} href="{{ link.url }}" class="menu__item text-sm-lg flex items-center font-medium z-2 relative cursor-pointer" is="magnet-link"{% if section.settings.menu_active == 'block' %} data-magnet="0"{% endif %} aria-label="{{ link.title | escape }}">
          <span class="btn-text" data-text>{{ link.title }}</span>
          {%- if section.settings.menu_active == 'block' -%}
            <span class="btn-text btn-duplicate">{{ link.title }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endif -%}
    {%- if link.title == 'Push Carts' -%}
      <li{% if collection.handle == 'accessories' %} class="rovic-nav-active"{% endif %}>
        <a {% if collection.handle == 'accessories' %}aria-current="page"{% endif %} href="{{ accessories_url }}" class="menu__item text-sm-lg flex items-center font-medium z-2 relative cursor-pointer" is="magnet-link"{% if section.settings.menu_active == 'block' %} data-magnet="0"{% endif %} aria-label="Accessories">
          <span class="btn-text" data-text>Accessories</span>
          {%- if section.settings.menu_active == 'block' -%}<span class="btn-text btn-duplicate">Accessories</span>{%- endif -%}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
